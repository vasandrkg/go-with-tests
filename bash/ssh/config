# Do not allow to disconnect from the remote ssh  session
# Put this "config" file at ~/.ssh/config

# Do not allow ssh connection to disconnect
Host *
    ServerAliveInterval 30
    ServerAliveCountMax 6
    TCPKeepAlive yes

# Munich. My EliteBook NoteBook Ubuntu 22.04 Linux Machine
Host munich
  PreferredAuthentications publickey
  HostName 192.168.0.101
  Port 2222
  User vasandrkg
  IdentityFile ~/.ssh/id_rsa

Host 192.168.0.101
  PreferredAuthentications publickey
  HostName 192.168.0.101
